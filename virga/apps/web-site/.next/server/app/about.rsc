6:["$","article",null,{"className":"mx-auto max-w-2xl","children":[["$","h1",null,{"className":"mb-6 text-3xl font-semibold tracking-tight","children":"About"}],["$","div",null,{"className":"prose","dangerouslySetInnerHTML":{"__html":"<p>This site runs on <strong>Virga</strong>, a baseline for websites with one owner and\nmany visitors. Everything you see is a Markdown file in a repository; the\nfew things that need a server — subscribing, upvoting, counting a view —\nrun on Cloudflare Workers.</p>\n<p>There is no console. The owner writes, pushes, and runs a CLI.</p>\n"}}]]}]
