// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
{
  "name": "cirrus-monitors-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  "vars": {
    "ENVIRONMENT": "local"
  },
  // The scheduler wakes every minute and probes whatever is due; a monitor's
  // own interval decides how often it is actually checked.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev"
      }
    },
    "stage": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage"
      },
      "triggers": {
        "crons": ["* * * * *"]
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "cirrus-stage",
          "database_id": "@@wiring(cloudflare-d1/stage:d1_database_id)@@"
        }
      ]
    },
    "prod": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod"
      },
      "triggers": {
        "crons": ["* * * * *"]
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "cirrus-prod",
          "database_id": "@@wiring(cloudflare-d1/prod:d1_database_id)@@"
        }
      ]
    }
  }
}
